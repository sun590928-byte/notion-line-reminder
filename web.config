<?xml version="1.0" encoding="UTF-8"?>
<!-- aftermoonF — IIS 備援設定：文件根目錄為專案根目錄時，把請求轉到 public/ -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Block private folders" stopProcessing="true">
          <match url="^(app|config|storage|tools|docs|node_modules|vendor|\.git)(/|$)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="To public" stopProcessing="true">
          <match url="^(?!public/)(.*)$" />
          <action type="Rewrite" url="public/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
